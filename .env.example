# ====================================================================
# AURO PERFECT VISION — PRODUCTION ENVIRONMENT CONFIGURATION
# Next.js 16 + Hostinger MySQL + Node.js 24 LTS
# ====================================================================

# --------------------------------------------------------------------
# 1. APPLICATION & RUNTIME SETTINGS
# --------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://auroperfectvision.com
PORT=3000

# --------------------------------------------------------------------
# 2. HOSTINGER MYSQL DATABASE (InnoDB)
# Created via Hostinger hPanel -> Databases -> MySQL Databases
# --------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_apv_db
DB_USER=u123456789_apv_user
DB_PASSWORD=your_strong_mysql_password_here
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# Cryptographic secret for signing HTTP-only staff session cookies.
# Generate with: openssl rand -base64 48
# --------------------------------------------------------------------
SESSION_SECRET=generate_a_random_64_char_secret_for_production_auth_here

# --------------------------------------------------------------------
# 4. DURABLE PERSISTENT FILE STORAGE (Outside Git Deployment Root)
# Hostinger web app deployments overwrite project files upon rebuild.
# Keep public uploads and private clinical EMR documents in home dir.
# --------------------------------------------------------------------
# Public uploads (Therapy media, CMS hero images, articles)
UPLOAD_DIR=~/apv_storage/uploads

# Confidential clinical documents (HIPAA/ISO-27001 isolated, non-HTTP)
PRIVATE_DOCS_DIR=~/apv_storage/private_clinical_docs

# --------------------------------------------------------------------
# 5. AUTOMATED SCHEDULED JOBS & CRON SECURITY
# Hostinger Cron Jobs -> Curl trigger with Bearer token
# --------------------------------------------------------------------
CRON_SECRET=generate_a_random_32_char_hex_secret_for_cron_here

# --------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN & PRACTITIONER BOOTSTRAP (First Seed Only)
# Used only during 'npm run db:seed' to initialize the first account
# --------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@auroperfectvision.com
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword2026!
ADMIN_INITIAL_NAME=Auro Perfect Vision Administrator
THERAPIST_INITIAL_EMAIL=therapist@auroperfectvision.com
THERAPIST_INITIAL_PASSWORD=ReplaceWithTherapistPassword2026!
THERAPIST_INITIAL_NAME=Dr. Ananya Sen

# --------------------------------------------------------------------
# 7. PAYMENT GATEWAY INTEGRATIONS (Optional / Live Merchant Mode)
# --------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=razorpay_live_secret_placeholder
PAYPAL_CLIENT_ID=paypal_live_client_id_placeholder
PAYPAL_CLIENT_SECRET=paypal_live_client_secret_placeholder

# --------------------------------------------------------------------
# 8. TRANSACTIONAL MESSAGING & NOTIFICATIONS
# Outgoing emails sent via Resend verified domain (auroperfectvision.com).
# Inbound customer replies and admin notifications route to official Gmail.
# --------------------------------------------------------------------
RESEND_API_KEY=re_live_api_key_placeholder
EMAIL_FROM=Auro Perfect Vision <notifications@auroperfectvision.com>
EMAIL_REPLY_TO=auroperfectvision@gmail.com
CONTACT_EMAIL=auroperfectvision@gmail.com
ADMIN_NOTIFICATION_EMAIL=auroperfectvision@gmail.com
WHATSAPP_CLOUD_API_TOKEN=whatsapp_live_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_number_id_placeholder
